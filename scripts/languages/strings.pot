msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.TUBER_TREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.TUBER_TREE_SAPLING_ITEM"
